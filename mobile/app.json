{
  "expo": {
    "name": "Supercity",
    "slug": "supercity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.supercity.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ff5223",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.supercity.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Supercity utilise ta position pour trouver les matchs et les terrains autour de toi."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Supercity utilise tes photos pour ta photo de profil et le logo de ton équipe.",
          "cameraPermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#ff5223",
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "supercity",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ff5223"
    },
    "extra": {
      "apiUrl": "https://supercity.fr/api/v1"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
